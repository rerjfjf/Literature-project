# ─── Book (Электронный учебник) — переменные окружения для хостинга ────
# Секрет для подписи API-токенов Book (JWT). Должен быть сильным и уникальным.
# По умолчанию (fallback) используется "local-dev-secret-change-me" — для продакшена задайте свой!
JWT_SECRET=your-strong-jwt-secret-for-book

# Общий секрет для SSO cookie (должен совпадать со всеми тремя сервисами).
# По умолчанию: "portal-dev-secret".
PORTAL_SECRET=your-portal-shared-secret

# API-ключ GROQ для ИИ-функций (диалог, проверка ответов).
# Можно указать как "GROQ_API_KEY=gsk_..." или просто одной строкой "gsk_...".
# Получить бесплатный ключ: https://console.groq.com/keys
GROQ_API_KEY=gsk_your-groq-api-key

# Модель GROQ, используемая ИИ (диалог и проверка работ). По умолчанию: qwen/qwen3.8-27b.
# Список доступных моделей для вашего ключа: GET https://api.groq.com/openai/v1/models
# SCORING_MODEL=groq/compound-mini

# ─── Постоянное хранение (PostgreSQL) ────────────────────────────────────
# Если задать DATABASE_URL, все данные (пользователи, группы, оценки, видеотека)
# дублируются в PostgreSQL. Обязательно на Render (бесплатный тариф): там диск
# эфемерный и файлы data/*.json стираются при каждом ре-деплое.
# Получить бесплатный PostgreSQL: https://neon.tech (копия строки подключения)
# или Render → New → PostgreSQL (если доступен в вашем аккаунте).
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Пароль админа для видеотеки (используется в /api/videos/login).
VIDEO_ADMIN_PASSWORD=12345

# Порт сервера (по умолчанию 4173). На Render задаётся автоматически.
PORT=4173

# Профиль Node.js (production для хостинга).
NODE_ENV=production

# ─── URL портала (адреса остальных сервисов) ───────────────────────────
# Используются для генерации /config.js → window.PORTAL_CONFIG.
# В продакшене укажите реальные HTTPS-адреса ваших сервисов.
BOOK_URL=https://book.your-domain.com
DIALOG_URL=https://dialog.your-domain.com
LITFAIR_URL=https://litfair.your-domain.com

# ─── SSO cookie ────────────────────────────────────────────────────────
# Если сервисы на разных субдоменах (book.example.com, dialog.example.com),
# задайте общий домен для cookie: .example.com
# PORTAL_COOKIE_DOMAIN=.example.com

# ─── CORS ─────────────────────────────────────────────────────────────
# Через запятую: домены, которым разрешён доступ к API.
# CORS_ORIGIN=https://book.your-domain.com,https://dialog.your-domain.com
